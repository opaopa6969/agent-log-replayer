  "description": "Browser-based LLM session replayer consuming agent-log-broker events",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && vite build frontend",
    "build:server": "tsc",
    "build:frontend": "vite build frontend",
    "dev": "tsx src/index.ts",
    "dev:frontend": "vite frontend",
    "start": "node dist/index.js",
    "test": "vitest",
    "lint": "eslint src/ frontend/"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "better-sqlite3": "^11.0.0",
    "express": "^4.21.0",
